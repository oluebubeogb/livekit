# Copy these into the Coolify resource's "Environment Variables". Never commit real values.

# API key/secret pairs, one per app that uses this LiveKit server. Generate: ./scripts/generate-keys.sh
#   one app:      LIVEKIT_KEYS=APIabc123def456: <secret>
#   several apps: LIVEKIT_KEYS={APIabc123def456: <secret-1venue>, APIzyx987wvu654: <secret-otherapp>}
LIVEKIT_KEYS=

# The server's public IPv4 (Contabo panel -> your VPS -> IP address)
NODE_IP=

# Signalling domain (set the same name as the Coolify domain on service "livekit", port 7880).
# Apps connect to wss://<LIVEKIT_DOMAIN>
LIVEKIT_DOMAIN=rtc.1venue.live
# TURN. TURN/UDP (port 3478) is always on and needs no domain or certificate.
# TURN/TLS is optional (strict corporate networks): set TURN_TLS_PORT=5349 and a SEPARATE
# TURN_DOMAIN (e.g. turn.1venue.live), then follow README "TURN over TLS". 0 = off.
TURN_DOMAIN=turn.1venue.live
TURN_TLS_PORT=0

# Optional tuning
LIVEKIT_VERSION=v1.13.11
LIVEKIT_LOG_LEVEL=info
LIVEKIT_MAX_PARTICIPANTS=0
LIVEKIT_MEM_LIMIT=2g
RTC_PORT_START=50000
RTC_PORT_END=60000
TURN_RELAY_START=30000
TURN_RELAY_END=30100
USE_EXTERNAL_IP=false
# LIVEKIT_REDIS_ADDRESS=127.0.0.1:6379
# LIVEKIT_REDIS_PASSWORD=
