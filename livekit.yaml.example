# Reference only: this is what docker-compose.yml generates into LIVEKIT_CONFIG from env vars.
# Keys are NOT in this file: they come from LIVEKIT_KEYS. Full option list:
# https://github.com/livekit/livekit/blob/master/config-sample.yaml
port: 7880
bind_addresses: [""]
log_level: info
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: false
  node_ip: 203.0.113.10          # NODE_IP: the server's public IPv4
  congestion_control:
    enabled: true
    allow_pause: true
room:
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 0
  auto_create: true
turn:
  enabled: true
  domain: turn.1venue.live       # TURN_DOMAIN, only used for TURN/TLS
  udp_port: 3478
  relay_range_start: 30000
  relay_range_end: 30100
  tls_port: 0                    # TURN_TLS_PORT: 0 = TURN/TLS off, 5349 = on (behind Traefik)
  external_tls: true
# redis:                         # multi-node only
#   address: 10.0.0.5:6379
#   password: ...
